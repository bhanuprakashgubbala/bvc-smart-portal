# =====================================================================
# BVC SMART PORTAL - SECURE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize for your deployment environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO PUBLIC REPOSITORIES.
# =====================================================================

# Server Environment Mode ('development' or 'production')
PORTAL_ENV=production

# Set to 'false' in production to disable demo OTP bypass and enforce strict security
DEVELOPMENT_MODE=false

# Bind Host and Port
HOST=127.0.0.1
PORT=5000

# Secret Key for HMAC-SHA256 Token Signing (minimum 32 random characters)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-32-byte-hex-secret-key-in-production

# Session Token Lifetime in Seconds (default: 86400 = 24 hours)
TOKEN_EXPIRY_SECONDS=86400

# Rate Limiting: Lockout window in seconds (default: 300 = 5 minutes)
RATE_LIMIT_WINDOW=300

# Rate Limiting: Maximum failed attempts before temporary throttling (default: 5)
MAX_FAILED_ATTEMPTS=5

# Database File Path (SQLite WAL Mode)
BVC_DB_FILE=bvc_portal.db

# Allowed CORS Origins (comma-separated list of approved origins)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Built-in Administrative Accounts (Optional Override)
# If omitted, initialized securely with modern PBKDF2/scrypt password hashes
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=change-admin-password-on-first-login
PRINCIPAL_USERNAME=PRIN001
PRINCIPAL_PASSWORD=change-principal-password-on-first-login

# Optional Supabase Integration (Leave false for standard standalone operation)
ENABLE_SUPABASE_BRIDGE=false
